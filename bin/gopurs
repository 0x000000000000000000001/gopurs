#!/usr/bin/env bash
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"

if [[ "${GOPURS_RUST:-0}" == "1" && "${GOPURS_JS:-0}" == "1" ]]; then
  echo "Error: select only one compiler host: GOPURS_RUST=1 or GOPURS_JS=1." >&2
  exit 1
fi

if [[ "${GOPURS_RUST:-0}" == "1" ]]; then
  if [[ ! -x "$DIR/gopurs-rust" ]]; then
    echo "Error: Rust-hosted gopurs is not built. Run npm run build:rust in $(dirname "$DIR")." >&2
    exit 1
  fi
fi

# Choose parallelism before dispatching the host. Explicit job settings take
# precedence, independently of the caller's Go GC policy.
mem_bytes="$(sysctl -n hw.memsize 2>/dev/null || true)"
if [[ ! "$mem_bytes" =~ ^[0-9]+$ && -r /proc/meminfo ]]; then
  mem_kb="$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo 2>/dev/null)"
  [[ "$mem_kb" =~ ^[0-9]+$ ]] && mem_bytes=$(( mem_kb * 1024 ))
fi
if [[ "${mem_bytes:-0}" =~ ^[0-9]+$ ]] && (( mem_bytes >= 32 * 1024 * 1024 * 1024 )); then
  if [[ -z "${GOPURS_PBO_JOBS:-}" ]]; then
    export GOPURS_PBO_JOBS=8
  fi
  if [[ -z "${GOPURS_PREPARE_JOBS:-}" ]]; then
    export GOPURS_PREPARE_JOBS=8
  fi

  # Bounded-memory GC policy belongs to the Go host only. In particular, the
  # Go parser embedded in the Rust host keeps its ordinary GC settings.
  if [[ "${GOPURS_RUST:-0}" != "1" && "${GOPURS_JS:-0}" != "1" && -z "${GOGC:-}" && -z "${GOMEMLIMIT:-}" ]]; then
    export GOGC=off
    export GOMEMLIMIT=10GiB
  fi
fi

if [[ "${GOPURS_RUST:-0}" == "1" ]]; then
  exec "$DIR/gopurs-rust" "$@"
elif [[ "${GOPURS_JS:-0}" == "1" ]]; then
  NODE_BIN=$(command -v node)
  if [ -z "$NODE_BIN" ]; then
      echo "Error: 'node' is not installed or not in the PATH." >&2
      exit 1
  fi
  # Le backend JS récurse sur les structures du corpus (listes/maps) : Node a
  # un stack fixe, contrairement au Go natif. Même valeur que les autres
  # chemins JS du projet.
  exec "$NODE_BIN" --stack-size=65536 "$DIR/gopurs.js" "$@"
else
  exec "$DIR/gopurs-native" "$@"
fi
