#!/usr/bin/env bash
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"

# Bounded-memory GC policy for the native compiler: fewer and longer GC cycles
# while keeping a predictable peak (measured: ~-20% backend time, peak ~12 GiB).
# Only applied when the caller has not chosen a policy and the machine can
# afford the bound; smaller machines keep the Go defaults.
if [[ -z "${GOGC:-}" && -z "${GOMEMLIMIT:-}" ]]; then
  mem_bytes="$(sysctl -n hw.memsize 2>/dev/null || true)"
  if [[ ! "$mem_bytes" =~ ^[0-9]+$ && -r /proc/meminfo ]]; then
    mem_kb="$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo 2>/dev/null)"
    [[ "$mem_kb" =~ ^[0-9]+$ ]] && mem_bytes=$(( mem_kb * 1024 ))
  fi
  if [[ "${mem_bytes:-0}" =~ ^[0-9]+$ ]] && (( mem_bytes >= 32 * 1024 * 1024 * 1024 )); then
    export GOGC=off
    export GOMEMLIMIT=10GiB
    # The parallel optimizer is byte-identical to the sequential build and
    # measured ~33% faster with a stable spread; smaller machines keep the
    # sequential builder.
    if [[ -z "${GOPURS_PBO_JOBS:-}" ]]; then
      export GOPURS_PBO_JOBS=8
    fi
  fi
fi

if [[ "${GOPURS_JS:-0}" == "1" ]]; then
  NODE_BIN=$(command -v node)
  if [ -z "$NODE_BIN" ]; then
      echo "Error: 'node' is not installed or not in the PATH." >&2
      exit 1
  fi
  exec "$NODE_BIN" "$DIR/gopurs.js" "$@"
else
  exec "$DIR/gopurs-native" "$@"
fi
