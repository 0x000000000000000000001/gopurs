#!/usr/bin/env bash

# Test runner for gopurs
# Compiles and runs PureScript passing tests.

ROOT_DIR=$(cd "$(dirname "$0")/.." && pwd)
TEST_DIR="$ROOT_DIR/tests"
PASSING_DIR="$TEST_DIR/passing"
RUNNER_DIR="$TEST_DIR/runner"
SNAPSHOTS_DIR="$TEST_DIR/passing-snapshots"
UPDATE_SNAPSHOTS=${UPDATE_SNAPSHOTS:-0}

# Tests to skip (e.g. tests using experimental compiler features not supported by our purs version)
BLACKLIST=(
  # For versions > 0.15
  "DerivingClause.purs"
  "DerivingContravariant.purs"
  "DerivingFunctorFromBi.purs"
  "DerivingFunctorFromPro.purs"
  "DerivingProfunctor.purs"
  # Fails in Go/JS because of precise IEEE-754 serialization differences
  "NumberLiterals.purs"
  # Fails in Go because Go strings are UTF-8 and replace lone surrogates with U+FFFD
  "StringEdgeCases.purs"
  "StringEscapes.purs"
  # Tests 32-bit integer boundary overflow behavior which gopurs natively treats as 64-bit
  "2136.purs"
)

source "$(dirname "$0")/pkg"

for pkg in "${CORE_PACKAGES[@]}"; do
  if [ ! -d "$ROOT_DIR/../gopurs-$pkg" ]; then
    echo -e "\033[0;31m[ERROR]\033[0m Missing sibling checkout: gopurs-$pkg"
    echo "Please run ./bin/setup to clone all required repositories automatically."
    exit 1
  fi
done

mkdir -p "$RUNNER_DIR/src"

passed=0
failed=0

SKIP_BEFORE=""
TEST_FILES=()
CLEAN_CACHE=0

if [ $# -gt 0 ]; then
  for arg in "$@"; do
    if [[ "$arg" == skip_before=* ]]; then
      SKIP_BEFORE="${arg#skip_before=}"
    elif [[ "$arg" == --skip-before=* ]]; then
      SKIP_BEFORE="${arg#--skip-before=}"
    elif [[ "$arg" == "-c" || "$arg" == "--clean" ]]; then
      CLEAN_CACHE=1
    else
      if [ -f "$ROOT_DIR/$arg" ]; then
        TEST_FILES+=("$ROOT_DIR/$arg")
      elif [ -f "$arg" ]; then
        TEST_FILES+=("$arg")
      elif [ -f "$PASSING_DIR/$arg" ]; then
        TEST_FILES+=("$PASSING_DIR/$arg")
      elif [ -f "$PASSING_DIR/$arg.purs" ]; then
        TEST_FILES+=("$PASSING_DIR/$arg.purs")
      else
        echo "Test file $arg not found."
      fi
    fi
  done
fi

if [ $CLEAN_CACHE -eq 1 ]; then
  echo "Building gopurs compiler..."
  cd "$ROOT_DIR"
  npm run build --silent || { echo -e "\n\033[0;31m[FAILED]\033[0m gopurs build failed!"; exit 1; }
fi

cd "$RUNNER_DIR"

if [ ! -f spago.yaml ]; then
  echo "package:" > spago.yaml
  echo "  name: runner" >> spago.yaml
  echo "  dependencies:" >> spago.yaml
  for pkg in "${CORE_PACKAGES[@]}"; do
    echo "    - $pkg" >> spago.yaml
  done
  echo "workspace:" >> spago.yaml
  echo "  packageSet:" >> spago.yaml
  echo "    registry: 77.10.1" >> spago.yaml
  echo "  extraPackages:" >> spago.yaml
  for pkg in "${CORE_PACKAGES[@]}"; do
    echo "    $pkg:" >> spago.yaml
    echo "      path: \"../../../gopurs-$pkg\"" >> spago.yaml
  done
fi

build_test() {
  local dependencies
  dependencies=$(sed -n 's/^-- @dependencies: //p' "$1")
  if [ -z "$dependencies" ]; then
    spago build -q
    return $?
  fi

  # Scope dependency selection to this build; preserve the shared runner config.
  (
    dependency_backup=$(mktemp -d "${TMPDIR:-/tmp}/gopurs-test-deps.XXXXXX") || exit 1
    cp spago.yaml "$dependency_backup/spago.yaml" || exit 1
    if [ -f spago.lock ]; then cp spago.lock "$dependency_backup/spago.lock" || exit 1; fi
    restore_dependencies() {
      local build_status=$?
      cp "$dependency_backup/spago.yaml" spago.yaml || exit 1
      if [ -f "$dependency_backup/spago.lock" ]; then
        cp "$dependency_backup/spago.lock" spago.lock || exit 1
      else
        rm -f spago.lock || exit 1
      fi
      rm -rf "$dependency_backup" || exit 1
      exit "$build_status"
    }
    trap restore_dependencies EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    node --input-type=module - "$dependencies" <<'NODE' || exit 1
import { readFileSync, writeFileSync } from "node:fs";
const packages = process.argv[2].trim().split(/\s+/);
if (!packages.every(name => /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(name))) {
  throw new Error("Invalid @dependencies package name");
}
const config = readFileSync("spago.yaml", "utf8");
const dependencyList = /^  dependencies:\n(?:    - [^\n]*\n)*/m;
if (!dependencyList.test(config)) throw new Error("Expected generated runner dependencies");
writeFileSync("spago.yaml", config.replace(dependencyList,
  "  dependencies:\n" + packages.map(name => `    - ${name}\n`).join("")));
NODE
    spago build -q
  )
}

echo "Running tests from $PASSING_DIR..."

if [ $CLEAN_CACHE -eq 1 ]; then
  echo "=> Cleaning Spago and output cache..."
  rm -rf .spago/* output-es/* output/*
fi

if [ ${#TEST_FILES[@]} -eq 0 ]; then
  TEST_FILES=("$PASSING_DIR"/*.purs)
fi

skipping_until=0
if [ -n "$SKIP_BEFORE" ] && [ ${#TEST_FILES[@]} -gt 1 ]; then
  skipping_until=1
fi

for test_file in "${TEST_FILES[@]}"; do
  test_name=$(basename "$test_file")
  
  if [ $skipping_until -eq 1 ]; then
    if [[ "$test_name" == "$SKIP_BEFORE" || "$test_name" == "$SKIP_BEFORE.purs" ]]; then
      skipping_until=0
    else
      continue
    fi
  fi
  
  # Check blacklist
  skip_test=0
  for b in "${BLACKLIST[@]}"; do
    if [ "$test_name" = "$b" ]; then
      skip_test=1
      break
    fi
  done
  
  if [ $skip_test -eq 1 ]; then
    echo "=> Skipping $test_name (blacklisted)"
    continue
  fi
  
  echo "=> Testing $test_name"

  # Ensure complete cleanup to prevent state bleed
  while [ -d "output/purescript" ]; do
    rm -rf output/Main src/* output/Test* output/go.mod output/app output/purescript output/M1 output/M2 output/M3 output/A output/B output/C output/Middle
    if [ -d "output/purescript" ]; then
      sleep 0.1
    fi
  done
  # Run once more in case the directory didn't exist but other files did
  rm -rf output/Main src/* output/Test* output/go.mod output/app output/M1 output/M2 output/M3 output/A output/B output/C output/Middle
  
  cp "$test_file" "src/Main.purs"
  echo "-- $(date +%s%N)" >> "src/Main.purs"
  if [ -f "${test_file%.purs}.go" ]; then
    cp "${test_file%.purs}.go" "src/Main.go"
  fi
  if [ -f "${test_file%.purs}.js" ]; then
    cp "${test_file%.purs}.js" "src/Main.js"
  fi
  
  test_dir="${test_file%.purs}"
  if [ -d "$test_dir" ]; then
    cp -r "$test_dir"/* "src/"
  fi
  
  # Try to build with spago (just generating corefn)
  retry=0
  max_retries=2
  build_success=0
  while [ $retry -le $max_retries ]; do
    if out=$(build_test "$test_file" 2>&1); then
      build_success=1
      break
    fi
    retry=$((retry+1))
  done

  if [ $build_success -eq 1 ]; then
    # Generate Go code
    ../../bin/gopurs --main Main
    
    if [ -d "output/purescript" ] && [ -f "output/purescript/Main.go" ]; then
      test_base_name="${test_name%.purs}"
      snapshot_suffixes=("")
      # Opt in per fixture: FFI wrappers are emitted separately from Main.go.
      if grep -Fxq -- '-- @snapshot-ffi' "$test_file"; then
        snapshot_suffixes+=("_ffi")
      fi
      snapshot_passed=1

      for snapshot_suffix in "${snapshot_suffixes[@]}"; do
        generated_file="output/purescript/Main${snapshot_suffix}.go"
        snapshot_file="$SNAPSHOTS_DIR/${test_base_name}${snapshot_suffix}.go"
        if [ ! -f "$generated_file" ]; then
          echo -e "   \033[0;31m[FAILED]\033[0m Missing snapshot source: $generated_file"
          snapshot_passed=0
          failed=$((failed+1))
          break
        fi

        # Normalize each selected Go file before comparing or updating it.
        if ! gofmt -w "$generated_file"; then
          echo -e "   \033[0;31m[FAILED]\033[0m Cannot format snapshot source: $generated_file"
          snapshot_passed=0
          failed=$((failed+1))
          break
        fi

        if [ "$UPDATE_SNAPSHOTS" -eq 1 ] || [ ! -f "$snapshot_file" ]; then
          if [ ! -f "$snapshot_file" ]; then
            echo -e "   \033[0;34m[INFO]\033[0m Creating initial snapshot: $snapshot_file"
          fi
          cp "$generated_file" "$snapshot_file"
        else
          if ! diff -u "$snapshot_file" "$generated_file" > output/diff.txt; then
            echo -e "   \033[0;31m[FAILED]\033[0m Snapshot mismatch: $snapshot_file"
            cat output/diff.txt
            snapshot_passed=0
            failed=$((failed+1))
            break
          fi
        fi
      done
      if [ "$snapshot_passed" -eq 0 ]; then
        break
      fi
      
      # Compile and Run Go code
      cd output
      rm -f go.mod
      go mod init gopurs/output > /dev/null 2>&1
      go mod tidy > /dev/null 2>&1
      
      if go build -o gopurs_main ./main/main.go; then
          output_run=$(./gopurs_main)
          exit_code=$?
          
          if [ -n "$output_run" ]; then
            echo "$output_run"
          fi
          
          if [ $exit_code -eq 0 ] && ! echo "$output_run" | grep -q "Fail"; then
            echo -e "   \033[0;32m[OK]\033[0m"
            passed=$((passed+1))
          else
            echo -e "   \033[0;31m[FAILED]\033[0m Execution error"
            failed=$((failed+1))
            break
          fi
      else
          echo -e "   \033[0;31m[FAILED]\033[0m Go Compilation error"
          failed=$((failed+1))
          break
      fi
      cd ..
    else
      echo -e "   \033[0;31m[FAILED]\033[0m gopurs did not generate Main.go"
      failed=$((failed+1))
      break
    fi
  else
    echo -e "   \033[0;31m[FAILED]\033[0m PureScript Compilation error"
    echo "$out"
    failed=$((failed+1))
    break
  fi
done

echo ""
if [ $failed -eq 0 ]; then
  echo -e "Summary: \033[0;32m$passed passed\033[0m, 0 failed."
else
  echo -e "Summary: \033[0;32m$passed passed\033[0m, \033[0;31m$failed failed\033[0m."
  exit 1
fi
