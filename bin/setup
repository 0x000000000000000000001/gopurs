#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR=$(cd "$(dirname "$0")/.." && pwd)
SIBLING_DIR="${GOPURS_LIBRARY_ROOT:-$ROOT_DIR/..}"
source "$ROOT_DIR/bin/pkg"

usage() {
  cat <<'USAGE'
Usage: ./bin/setup [--core | --all] [--locked] [--list]

  --core  Install the 22 core libraries and their 3 supporting checkouts (default).
  --all   Install all 51 libraries, including the Go QuickCheck adaptation.
  --locked  Require existing checkouts to match the clean, pinned release inputs.
  --list  Print the selected directories without cloning or changing files.

New checkouts use bootstrap-sources.json revisions. Existing checkouts are
preserved; --locked rejects a changed revision or working tree instead of
overwriting it. GOPURS_LIBRARY_ROOT selects the destination directory.
The TAST compiler must be installed separately; see docs/bootstrap.md.
USAGE
}

profile=core
selected_profile=
list_only=0
locked=0
for arg in "$@"; do
  case "$arg" in
    --core|--all)
      if [[ -n "$selected_profile" && "$selected_profile" != "$arg" ]]; then
        echo "Use either --core or --all." >&2
        exit 2
      fi
      selected_profile=$arg
      profile=${arg#--}
      ;;
    --list) list_only=1 ;;
    --locked) locked=1 ;;
    --help|-h) usage; exit 0 ;;
    *) echo "Unknown option: $arg" >&2; usage >&2; exit 2 ;;
  esac
done

packages=("${CORE_PACKAGES[@]}" "${CORE_CHECKOUT_DEPENDENCIES[@]}")
if [[ "$profile" == all ]]; then
  packages+=("${ADDITIONAL_PACKAGES[@]}")
fi

if [[ "$list_only" == 1 ]]; then
  printf 'gopurs-%s\n' "${packages[@]}"
  exit 0
fi

exec node "$ROOT_DIR/tools/setup-libraries.mjs" "$ROOT_DIR" "$SIBLING_DIR" "$locked" "${packages[@]}"
