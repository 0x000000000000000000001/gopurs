# Suppress PureScript entirely from stats
*.purs linguist-detectable=false
*.purs linguist-vendored

# Keep JS generated diffs hidden
*.js linguist-generated
bin/gopurs.js linguist-generated

# Only include target language
*.go linguist-detectable=true
*.go linguist-vendored=false

# Suppress Dhall entirely from stats
*.dhall linguist-detectable=false
*.dhall linguist-vendored

# Suppress AI artifact languages from stats
*.py linguist-detectable=false
*.py linguist-vendored
*.js linguist-detectable=false
*.js linguist-vendored
*.sh linguist-detectable=false
*.sh linguist-vendored

bin/* linguist-detectable=false
bin/* linguist-vendored
