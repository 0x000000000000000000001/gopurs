# Show only Go in GitHub's language statistics.
* linguist-detectable=false
*.go linguist-detectable=true
*.go linguist-vendored=false

# Upstream compiler fixtures are vendored test data, not project source.
tests/passing/** linguist-vendored=true

# Generated golden outputs.
tests/passing-snapshots/** linguist-generated=true
tests/passing-snapshots-dev/** linguist-generated=true

# Generated bundles and embedded runtime snapshots.
bin/gopurs.js linguist-generated=true
src/Gopurs/Runtime/Source.js linguist-generated=true
tools/wasm_exec.js linguist-generated=true
.tmp-nix-cache/ export-ignore
