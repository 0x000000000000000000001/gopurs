#!/usr/bin/env bash
set -euo pipefail

THUNK_TEST_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GOPURS_TEST_ROOT="$(cd "$THUNK_TEST_DIR/../.." && pwd)"
# Select the same TAST-capable frontend as the application under test.
GOPURS_TEST_TOOL_DIR="${GOPURS_TEST_TOOL_DIR:-$GOPURS_TEST_ROOT/node_modules/.bin}"
GOPURS_TEST_TOOL_DIR="$(cd "$GOPURS_TEST_TOOL_DIR" && pwd)"
export PATH="$GOPURS_TEST_TOOL_DIR:$PATH"

cd "$GOPURS_TEST_ROOT"
npm run build --silent
cd "$THUNK_TEST_DIR"
# Distinct custom frontends can report the same version but emit different
# CoreFn metadata, so do not reuse this isolated fixture's old output.
rm -rf output
spago build
"$GOPURS_TEST_ROOT/bin/gopurs" --main Main
node --input-type=module - output/purescript/Main.go <<'NODE'
import assert from "node:assert/strict";
import { readFileSync } from "node:fs";

const source = readFileSync(process.argv[2], "utf8");
// Ignore braces in Go strings/comments, retaining positions and line breaks.
const masked = source.replace(/"(?:\\.|[^"\\])*"|`[^`]*`|'(?:\\.|[^'\\])*'|\/\/[^\n]*|\/\*[\s\S]*?\*\//g,
  text => text.replace(/[^\n]/g, " "));
const bodies = new Map();
const declarations = /^func ([A-Za-z_][A-Za-z0-9_]*)\([^\n]*\)[^{]*\{/gm;
for (const match of masked.matchAll(declarations)) {
  const start = match.index + match[0].length;
  let end = start;
  let depth = 1;
  while (depth > 0 && end < masked.length) {
    const char = masked[end++];
    if (char === "{") depth++;
    if (char === "}") depth--;
  }
  assert.equal(depth, 0, `Unclosed Go function: ${match[1]}`);
  bodies.set(match[1], masked.slice(start, end - 1));
}
const body = name => {
  assert.ok(bodies.has(name), `Missing generated function: ${name}`);
  return bodies.get(name);
};

for (const [consumer, producer] of [
  ["runAdds", "suspendAdds"],
  ["runOrder", "suspendOrder"],
  ["runVary", "suspendVary"],
  ["runClash", "suspendClash_prime_"],
]) {
  const consumerBody = body(`Call_Main_${consumer}`);
  const reference = consumerBody.match(new RegExp(`\\b(Call|Get)_Main_(${producer}__gopurs_strict_thunk_[0-9]+)\\s*\\(`));
  assert.ok(reference, `${consumer} does not call its strict worker`);
  const worker = `Call_Main_${reference[2]}`;
  body(worker);
  if (reference[1] === "Get") {
    assert.ok(body(`Get_Main_${reference[2]}`).includes(`${worker}(`),
      `${consumer}'s getter does not reach its strict worker`);
  }
  assert.ok(!new RegExp(`\\b(?:Call|Get)_Main_${producer}\\s*\\(`).test(consumerBody),
    `${consumer} still calls the thunk producer`);
}

for (const [consumer, producer] of [
  ["runConditionalInt", "suspendConditionalInt"],
  ["runOverwriteTotal", "suspendOverwrite"],
  ["runTwice", "suspendTwice"],
]) {
  body(`Call_Main_${producer}`);
  const consumerBody = body(`Call_Main_${consumer}`);
  assert.ok(new RegExp(`\\b(?:Call|Get)_Main_${producer}\\s*\\(`).test(consumerBody),
    `${consumer} no longer exercises its rejected producer`);
  const workerPattern = new RegExp(`^Call_Main_${producer}.*__gopurs_strict_thunk_[0-9]+$`);
  assert.ok(![...bodies.keys()].some(name => workerPattern.test(name)),
    `${producer} must not receive a strict worker`);
}
console.log("Thunk fusion structure: 4 fused consumers, 3 rejected producers verified");
NODE
cd output
go build -o thunk-fusion ./main
./thunk-fusion
