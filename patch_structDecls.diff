-          map (\ctor ->
-            let
-              fields = Array.mapWithIndex (\i ty -> "V" <> show i <> " " <> goTypeToStr (exprTypeToGoType ty)) ctor.fieldTypes
-              structName = "Data_" <> modNameStr <> "_" <> sanitizeName ctor.constructorName
