{
  "name": "gopurs",
  "version": "0.1.0",
  "description": "PureScript-to-Go backend",
  "type": "module",
  "bin": {
    "gopurs": "bin/gopurs.js"
  },
  "scripts": {
    "build": "spago build && spago bundle --module Main --platform node --outfile bin/gopurs.js --bundle-type app",
    "build:ffi": "node tools/build-ffi.mjs",
    "test:ffi": "node --test tools/ffi-errors.test.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "purs-backend-es": "^1.4.3"
  },
  "devDependencies": {
    "purescript-npm": "github:0x000000000000000000001/purescript-npm#main",
    "spago": "^0.93.45"
  }
}
