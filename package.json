{
  "name": "gopurs",
  "version": "0.1.0",
  "description": "PureScript-to-Go backend",
  "type": "module",
  "bin": {
    "gopurs": "bin/gopurs.js"
  },
  "scripts": {
    "build": "spago build && node_modules/.bin/esbuild output/Main/index.js --bundle --platform=node --format=esm --outfile=bin/gopurs.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "purs-backend-es": "^1.4.3"
  },
  "devDependencies": {
    "purescript": "github:0x000000000000000000001/purescript-npm"
  }
}
