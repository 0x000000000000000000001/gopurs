{
  "name": "gopurs",
  "version": "0.1.0-rc.6",
  "description": "PureScript-to-Go backend",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0x000000000000000000001/gopurs.git"
  },
  "bugs": {
    "url": "https://github.com/0x000000000000000000001/gopurs/issues"
  },
  "homepage": "https://github.com/0x000000000000000000001/gopurs#readme",
  "engines": {
    "node": ">=24.8.0 <25"
  },
  "bin": {
    "gopurs": "bin/gopurs.js"
  },
  "files": [
    "bin/gopurs",
    "bin/gopurs.js",
    "docs/architecture-overview.md",
    "docs/benchmark-protocol.md",
    "docs/bootstrap.md",
    "docs/cli.md",
    "docs/limitations.md",
    "docs/migration.md",
    "docs/nix.md",
    "docs/publication-scope.md",
    "docs/quickstart.md",
    "docs/release.md",
    "docs/troubleshooting.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "NOTICE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "tools/build-cache.mjs",
    "tools/build-cache/compiler.go",
    "tools/build-cache/contract.go",
    "tools/build-cache/capsules.go",
    "tools/build-cache/go.mod",
    "tools/build-cache/inputpack.go",
    "tools/build-cache/main.go",
    "tools/build-cache/modules.go",
    "tools/build-cache/overlay.go",
    "tools/build-cache/overlay_sections.go",
    "tools/build-cache/packages.go",
    "tools/build-cache/packs.go",
    "tools/build-cache/profiles.go",
    "tools/build-cache/session.go",
    "tools/build-cache/store.go",
    "tools/c1c/go.mod",
    "tools/c1c/literals.go",
    "tools/c1c/manifest.go",
    "tools/c1c/overlay.go",
    "tools/c1c/partition.go",
    "tools/c1c/qualify.go",
    "tools/c1c/rewrite.go",
    "tools/ffi-gen/bindings.go",
    "tools/ffi-gen/cache_carchive.go",
    "tools/ffi-gen/go.mod",
    "tools/ffi-gen/main_carchive.go",
    "tools/ffi-gen/main_js_wasm.go",
    "tools/ffi-gen/main_workspace.go",
    "tools/ffi-gen/native_api.go",
    "tools/ffi-gen/packages.go",
    "tools/ffi-gen/parser.go",
    "tools/ffi-gen/types.go",
    "tools/ffi-gen/workspace.go",
    "tools/ffi-runner.mjs",
    "tools/ffi_gen.wasm",
    "tools/go-packages.mjs",
    "tools/wasm_exec.js"
  ],
  "scripts": {
    "build": "npm run build:runtime && spago build && spago bundle --module Main --platform node --outfile bin/gopurs.js --bundle-type app",
    "build:runtime": "node tools/embed-runtime.mjs",
    "build:native": "node tools/build-native.mjs",
    "build:rust": "node tools/build-rust.mjs",
    "build:ffi": "node tools/build-ffi.mjs",
    "checksums": "node tools/bootstrap-checksums.mjs",
    "release:prepare": "node tools/release-prepare.mjs",
    "release:smoke": "node tools/release-smoke.mjs",
    "release:quality": "node tools/release-quality.mjs",
    "test:ffi": "node --test tools/ffi-errors.test.mjs",
    "test:cli": "node --test tools/cli.test.mjs",
    "test:profiles": "node --test --test-concurrency=1 tools/build-profiles.test.mjs tools/dev-specialization.test.mjs tools/dev-loop-state.test.mjs tools/recursive-function-result.test.mjs",
    "test:launcher": "node --test tools/launcher.test.mjs",
    "test:package": "node tools/check-package.mjs",
    "test:rust": "GOPURS_TEST_RUST=1 node --test --test-concurrency=1 tools/launcher.test.mjs tools/cli.test.mjs tools/rust-host.test.mjs",
    "test:runner": "node --test tools/test-runner.test.mjs",
    "test:cache": "node --test tools/build-cache.test.mjs tools/build-cache-output.test.mjs tools/compiler-snapshot.test.mjs",
    "test:cache-driver": "node --test tools/driver-cache.test.mjs",
    "test:cache-sources": "node --test tools/driver-source-cache.test.mjs",
    "test:cache-context": "node --test tools/driver-context-cache.test.mjs",
    "test:cache-codecs": "node --test tools/module-codec.test.mjs tools/cache-pool.test.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "purescript": "0.15.16",
    "spago": "0.93.45",
    "esbuild": "0.28.1"
  }
}
